rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only authenticated users can access the storage
    match /groups/{groupId}/audio/{userId}/{fileName} {
      // Any authenticated user can read (could be restricted to group members, but simple auth is fine for now)
      allow read: if request.auth != null;
      
      // Users can only upload webm audio files up to 10MB
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }
    
    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
