rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    match /users/{userId} {
      allow read: if isSignedIn()
        && request.auth.uid == userId;
      allow write: if isSignedIn()
        && request.auth.uid == userId;
      match /notes/{noteId} {
        allow read, write: if isSignedIn()
          && request.auth.uid == userId;
      }
      match /bookmarks/{bookmarkId} {
        allow read, write: if isSignedIn()
          && request.auth.uid == userId;
      }
      match /memorizationPlans/{planId} {
        allow read, write: if isSignedIn()
          && request.auth.uid == userId;
      }
      match /memorizationProgress/{progressId} {
        allow read, write: if isSignedIn()
          && request.auth.uid == userId;
      }
      match /fcmTokens/{tokenId} {
        allow read, write: if isSignedIn()
          && request.auth.uid == userId;
      }
      match /adhkarProgress/{itemId} {
        allow read, write: if isSignedIn()
          && request.auth.uid == userId;
      }
      match /adhkarFavorites/{itemId} {
        allow read, write: if isSignedIn()
          && request.auth.uid == userId;
      }
      match /prayerSettings/{docId} {
        allow read, write: if isSignedIn()
          && request.auth.uid == userId;
      }
      match /recitationSessions/{sessionId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == userId
          && request.resource.data.status == 'started'
          && request.resource.data.surahNumber is int
          && request.resource.data.surahNumber >= 1
          && request.resource.data.surahNumber <= 114
          && request.resource.data.startAyah is int
          && request.resource.data.endAyah is int
          && request.resource.data.startAyah >= 1
          && request.resource.data.endAyah >= request.resource.data.startAyah
          && request.resource.data.endAyah - request.resource.data.startAyah <= 19
          && request.resource.data.verseKeys is list;
        allow update: if isSignedIn()
          && request.auth.uid == userId
          && resource.data.userId == userId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.surahNumber == resource.data.surahNumber
          && request.resource.data.startAyah == resource.data.startAyah
          && request.resource.data.endAyah == resource.data.endAyah
          && request.resource.data.status in ['started', 'completed', 'abandoned'];
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
    match /auditLogs/{logId} {
      allow read: if isSignedIn() && (request.auth.token.email == 'fatoomnoour@gmail.com' || request.auth.token.email == 'admin@athar-ayah.com');
      allow write: if false; // Only Cloud Functions (Admin SDK) can write to auditLogs
    }
    match /groups/{groupId} {
      function oldMemberIds() {
        return resource.data.memberIds is list ? resource.data.memberIds : [];
      }
      function newMemberIds() {
        return request.resource.data.memberIds is list ? request.resource.data.memberIds : [];
      }
      function isGroupAdmin() {
        return isSignedIn()
          && (
            request.auth.uid == resource.data.adminId
            || request.auth.uid == resource.data.createdBy
          );
      }
      function isJoiningSelf() {
        return isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'memberIds',
            'members',
            'updatedAt'
          ])
          && newMemberIds().hasAll(oldMemberIds())
          && request.auth.uid in newMemberIds()
          && (
            request.auth.uid in oldMemberIds()
            || newMemberIds().size() == oldMemberIds().size() + 1
          );
      }
      function isLeavingSelf() {
        return isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'memberIds',
            'members',
            'membersCount',
            'updatedAt'
          ])
          && request.auth.uid in oldMemberIds()
          && !(request.auth.uid in newMemberIds())
          && oldMemberIds().hasAll(newMemberIds())
          && newMemberIds().size() == oldMemberIds().size() - 1
          && request.auth.uid != resource.data.adminId
          && request.auth.uid != resource.data.createdBy;
      }
      // Required for searching by joinCode.
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds;
      // Join group or admin update.
      allow update: if isJoiningSelf() || isLeavingSelf() || isGroupAdmin();
      allow delete: if isGroupAdmin();
      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && memberId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn()
          && (memberId == request.auth.uid || request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.adminId || request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy);
      }
      match /reflections/{reflectionId} {
        function isReflectionMember() {
          return isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }
        function isReflectionAdmin() {
          return isSignedIn()
            && (
              request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.adminId
              || request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
            );
        }
        function changedOnlyReaction() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'reactionUserIds',
            'updatedAt'
          ]);
        }
        function changedOnlyComments() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'comments',
            'updatedAt'
          ]);
        }
        function ownerUpdateWithoutPin() {
          return request.auth.uid == resource.data.userId
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPinned']);
        }
        allow read: if isReflectionMember();
        allow create: if isReflectionMember()
          && request.resource.data.userId == request.auth.uid;
        allow update: if isReflectionMember()
          && (
            isReflectionAdmin()
            || ownerUpdateWithoutPin()
            || changedOnlyReaction()
            || changedOnlyComments()
          );
        allow delete: if isReflectionAdmin()
          || request.auth.uid == resource.data.userId;
      }
    }
  }
}
